<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>[% title %]</title>
    <link rel="stylesheet" href="/css/app.css" />
    <script defer src="/js/app.js"></script>
  </head>
  <body>
    <main class="shell">
      <h1>[% headline %]</h1>
      <p id="frameworks">Plack + Starman + Dancer2 + Template Toolkit</p>
      <p id="asset-root">[% asset_root %]</p>
      <button id="ping" type="button">Ping</button>
      <pre id="result">ready</pre>
    </main>
  </body>
</html>
